# ============================================================
# SOMA backend — environment variables
# ------------------------------------------------------------
# Copy this file to .env and fill in real values there.
# .env must NEVER be committed to git (add it to .gitignore).
# In production, set these in your host's secret manager
# (Render/Railway/Fly/Vercel/EC2 env vars, etc.) instead of a file.
# ============================================================

# Which AI provider adapter to use: "openrouter", "anthropic", or "openai"
AI_PROVIDER=openrouter

# The real API key for that provider. NEVER put this in frontend
# code, a JS file, or a git commit — this file only ever holds a
# placeholder.
# For OpenRouter: starts with "sk-or-v1-..."
AI_API_KEY=your_openrouter_api_key_heregit status


# The model name for the chosen provider, e.g.:
#   openrouter → openrouter/free, google/gemma-4-31b-it:free, openrouter/auto
#   anthropic  → claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
#   openai     → gpt-4o-mini, gpt-4o
AI_MODEL=openrouter/free

# ---- Optional ----

# Port the backend listens on
PORT=3000

# Comma-separated list of frontend origins allowed to call this
# backend. Use "*" only for local development.
ALLOWED_ORIGIN=*

# ============================================================
# Email Notification Configuration (General Enquiry Form)
# ------------------------------------------------------------
# Recipient for all website enquiries:
EMAIL_TO=snapassure@gmail.com

# SMTP provider settings (default is Gmail SSL):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender Gmail account and Google App Password:
# (Generate a 16-character App Password at: myaccount.google.com/apppasswords)
SMTP_USER=snapassure@gmail.com
SMTP_PASS=gcwv clty aafi slrw

# How many catalogue experiences to inject as context per request
MAX_CONTEXT_EXPERIENCES=6

# ============================================================
# Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
# URL: Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (recommended for backend server — bypasses RLS for admin writes)
# Found in: Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Anon / Public Key (alternative or for public client use)
# Found in: Project Settings → API → anon (public)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: custom table names (defaults are 'enquiries' and 'chat_logs')
# SUPABASE_ENQUIRIES_TABLE=enquiries
# SUPABASE_CHAT_LOGS_TABLE=chat_logs

