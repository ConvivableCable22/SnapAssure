{
  "name": "snapassure-soma-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Secure backend for SOMA (SnapAssure's AI assistant) — holds the real AI API key and proxies chat requests to a configurable AI provider.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
