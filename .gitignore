# ============================================================
# SnapAssure — Git Ignore Configuration
# ============================================================

# Environment variables & API credentials (CRITICAL: NEVER COMMIT)
.env
*.env
**/.env
.env.local
.env.*.local

# Dependency directories
node_modules/
**/node_modules/
package-lock.json

# Local enquiry store & runtime database
backend/data/
**/data/enquiries.json

# Logs & debugging output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch & test assets
scratch/
.system_generated/

# OS metadata & caches
.DS_Store
Thumbs.db
desktop.ini

# Editor & IDE directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
